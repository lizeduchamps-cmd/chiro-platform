# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore — deel die waarden nooit in de chat of in git.

# Discord Developer Portal (discord.com/developers/applications) > jouw app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth — genereer een willekeurige string, bv. via: openssl rand -base64 32
NEXTAUTH_SECRET=
# Lokaal: http://localhost:3000 — op Vercel: je echte deploy-URL
NEXTAUTH_URL=http://localhost:3000

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — geheim, geeft volledige databasetoegang, enkel server-side gebruikt
SUPABASE_SERVICE_ROLE_KEY=
